# 用户行为看板 — 数仓 MCP 取数
# 复制为 .env 后填写；勿将含真实密钥的 .env 提交到 Git

# local = 本地 JSON/SQLite（默认）；warehouse = 通过 MCP 查数仓
DATA_SOURCE=warehouse

# 与 Cursor mcp.json 中 hologres/maxcompute 的 X-MCP-Key 一致
MCP_KEY=

# DeepSeek AI 分析（必填，否则看板提示 API 请求失败）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 可选（一般不用改）
HOLOGRES_MCP_URL=https://test-dmp-mcp.xkw.com/hologres-mcp
MAXCOMPUTE_MCP_URL=https://test-dmp-mcp.xkw.com/maxcompute-mcp

# hologres | maxcompute
WAREHOUSE_ENGINE=hologres

# MaxCompute 回退时的资源与等待
ODPS_MAX_CU=100
ODPS_WAIT_MS=180000
