# Vercel / 本地线上同源 API 环境变量示例（勿提交真实密钥）
# 在 Vercel → Project → Settings → Environment Variables 中配置

DATA_SOURCE=warehouse
MCP_KEY=
HOLOGRES_MCP_URL=https://test-dmp-mcp.xkw.com/hologres-mcp
MAXCOMPUTE_MCP_URL=https://test-dmp-mcp.xkw.com/maxcompute-mcp
# Vercel 上建议 maxcompute（更稳）；本地可 hologres
WAREHOUSE_ENGINE=maxcompute
DEEPSEEK_API_KEY=
ODPS_MAX_CU=100
ODPS_WAIT_MS=180000
