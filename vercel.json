{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    { "source": "/user-behavior", "destination": "/user-behavior.html" }
  ],
  "headers": [
    {
      "source": "/搜索数据看板（周度）/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/搜索数据看板（周度）/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/getData.js": { "maxDuration": 60, "memory": 1024 },
    "api/analyze.js": { "maxDuration": 60, "memory": 1024 },
    "api/stats.js": { "maxDuration": 10 }
  },
  "installCommand": "echo 'Skipping install'",
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "."
}
